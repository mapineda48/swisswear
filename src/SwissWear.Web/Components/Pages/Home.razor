@page "/"
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Nav_Home"] - @L["Home_Title"]</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">@L["Home_Title"]</MudText>
<MudText Typo="Typo.subtitle1" Class="mb-6" Color="Color.Secondary">@L["Home_Subtitle"]</MudText>

<MudGrid>
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-6" Elevation="2">
            <MudText Typo="Typo.h5" GutterBottom="true">@L["Home_WhatIsThis"]</MudText>
            <MudText Typo="Typo.body1" Class="mb-4">@L["Home_Description"]</MudText>

            <MudText Typo="Typo.h6" GutterBottom="true">@L["Home_TechStack"]</MudText>
            <MudList T="string" Dense="true">
                <MudListItem Icon="@Icons.Material.Filled.Code" Text="@L["Home_Tech_Blazor"].Value" />
                <MudListItem Icon="@Icons.Material.Filled.Palette" Text="@L["Home_Tech_MudBlazor"].Value" />
                <MudListItem Icon="@Icons.Material.Filled.Storage" Text="@L["Home_Tech_Postgres"].Value" />
                <MudListItem Icon="@Icons.Material.Filled.Cloud" Text="@L["Home_Tech_Azure"].Value" />
                <MudListItem Icon="@Icons.Material.Filled.Settings" Text="@L["Home_Tech_EF"].Value" />
                <MudListItem Icon="@Icons.Material.Filled.Speed" Text="@L["Home_Tech_Valkey"].Value" />
                <MudListItem Icon="@Icons.Material.Filled.ViewInAr" Text="@L["Home_Tech_Docker"].Value" />
            </MudList>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-6" Elevation="2">
            <MudText Typo="Typo.h6" GutterBottom="true">@L["Home_Modules"]</MudText>
            <MudNavMenu>
                <MudNavLink Href="people" Icon="@Icons.Material.Filled.People" Match="NavLinkMatch.All">
                    @L["Home_Module_People"]
                </MudNavLink>
                <MudNavLink Href="" Icon="@Icons.Material.Filled.Chat" Match="NavLinkMatch.All">
                    @L["Home_Module_Chat"]
                </MudNavLink>
            </MudNavMenu>
        </MudPaper>

        <MudPaper Class="pa-6 mt-4" Elevation="2">
            <MudText Typo="Typo.h6" GutterBottom="true">@L["Home_QuickStart"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                <code>docker compose up -d</code>
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                <code>dotnet ef database update</code>
            </MudText>
            <MudText Typo="Typo.body2">
                <code>dotnet watch --project src/SwissWear.Web</code>
            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>
