@using SwissWear.Web.Components.Layout.Chat
@inject IChatService ChatService
@inject IStringLocalizer<AppStrings> L
@inject IJSRuntime JS
@inject IHttpContextAccessor HttpContextAccessor
@implements IAsyncDisposable

@if (_isOpen)
{
    <MudPaper Elevation="8" Class="chat-container">
        @* ── Header ── *@
        <div class="chat-header">
            <MudAvatar Size="Size.Small" Style="background: rgba(255,255,255,0.2);">
                <MudIcon Icon="@Icons.Material.Filled.Forum" Size="Size.Small" Style="color: white;" />
            </MudAvatar>
            <div style="flex: 1;">
                <MudText Typo="Typo.body1" Style="color: white; font-weight: 600; line-height: 1.2;">@L["Chat_Title"]</MudText>
                <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.7); line-height: 1.2;">
                    @_activeUsers.Count @L["Chat_OnlineUsers"].ToString().ToLower()
                </MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Style="color: rgba(255,255,255,0.8);" Size="Size.Small" OnClick="Toggle" />
        </div>

        @* ── Messages ── *@
        <div id="chat-messages" @ref="_messagesContainer" class="chat-messages">
            @if (_messages.Count == 0)
            {
                <div class="chat-empty">
                    <MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">@L["Chat_NoMessages"]</MudText>
                </div>
            }
            else
            {
                @foreach (var msg in _messages)
                {
                    <ChatMessageBubble Message="msg"
                                       IsOwn="msg.UserId == _userId"
                                       OnImageClicked="args => OpenLightbox(args.Images, args.Index)" />
                }
            }
        </div>

        @* ── Typing indicator ── *@
        @if (_typingNames.Count > 0)
        {
            <div class="chat-typing">
                <span>@GetTypingText()</span>
            </div>
        }

        @* ── Image previews ── *@
        @if (_pendingImages.Count > 0)
        {
            <div class="chat-previews">
                @for (var i = 0; i < _pendingImages.Count; i++)
                {
                    var idx = i;
                    var img = _pendingImages[i];
                    <div class="chat-preview-item">
                        <img src="data:@img.ContentType;base64,@img.Base64" class="chat-preview-img" alt="preview" />
                        <button type="button" @onclick="() => RemovePendingImage(idx)" class="chat-preview-remove">✕</button>
                    </div>
                }
                <button type="button" @onclick="TriggerFileInput" class="chat-preview-add">+</button>
            </div>
        }

        @* ── Recording indicator ── *@
        @if (_isRecording)
        {
            <div class="chat-recording">
                <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Color="Color.Error" Size="Size.Small" Class="chat-recording-icon" />
                <MudText Typo="Typo.caption" Color="Color.Error">@L["Chat_Recording"]</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" OnClick="CancelRecording">@L["Common_Cancel"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Send" OnClick="StopAndSendRecording">@L["Chat_SendShort"]</MudButton>
            </div>
        }

        @* ── Input bar ── *@
        @if (!_isRecording)
        {
            <ChatInputBar @bind-CurrentText="_messageInput"
                           HasPendingImages="_pendingImages.Count > 0"
                           OnSend="Send"
                           OnMicClicked="StartRecording"
                           OnAttachClicked="TriggerFileInput"
                           OnTextChanged="OnTextChanged"
                           OnFilesSelected="OnImagesSelected" />
        }
    </MudPaper>
}

@* ── Image Lightbox ── *@
@if (_lightboxImages is not null)
{
    <ChatLightbox Images="_lightboxImages"
                  CurrentIndex="_lightboxIndex"
                  OnClose="CloseLightbox"
                  OnIndexChanged="idx => { _lightboxIndex = idx; StateHasChanged(); }" />
}

@* ── FAB ── *@
<MudFab StartIcon="@(_isOpen ? Icons.Material.Filled.ChatBubble : Icons.Material.Filled.Chat)"
        Color="Color.Primary"
        Class="chat-fab"
        OnClick="Toggle"
        Size="Size.Large" />

@code {
    private bool _isOpen;
    private string _userId = "";
    private string _messageInput = "";
    private List<ChatMessage> _messages = new();
    private List<(string Id, string Name)> _activeUsers = new();
    private Dictionary<string, string> _typingNames = new();
    private System.Threading.Timer? _typingTimer;
    private bool _isTyping;
    private ElementReference _messagesContainer;
    private bool _shouldScrollToBottom;
    private bool _isRecording;
    private bool _cancelRecording;
    private DotNetObjectReference<ChatWidget>? _dotNetRef;
    private readonly System.Text.StringBuilder _audioChunks = new();
    private IJSObjectReference? _jsModule;

    private List<ImageData> _pendingImages = new();
    private IReadOnlyList<ImageData>? _lightboxImages;
    private int _lightboxIndex;
    private ClientInfo? _clientInfo;

    protected override async Task OnInitializedAsync()
    {
        _userId = await ChatService.RegisterUserAsync();
        _messages = (await ChatService.GetRecentMessagesAsync()).ToList();
        _activeUsers = (await ChatService.GetActiveUsersAsync()).ToList();
        _dotNetRef = DotNetObjectReference.Create(this);

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is not null)
        {
            var ip = httpContext.Connection.RemoteIpAddress?.ToString() ?? "unknown";
            var userAgent = httpContext.Request.Headers.UserAgent.ToString();
            _clientInfo = new ClientInfo(ip, userAgent);
        }

        ChatService.OnMessageReceived += HandleMessage;
        ChatService.OnUserJoined += HandleUserJoined;
        ChatService.OnUserLeft += HandleUserLeft;
        ChatService.OnTypingChanged += HandleTypingChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isOpen) return;

        _jsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat-interop.js");

        await _jsModule.InvokeVoidAsync("initAudioPlayers");
        await _jsModule.InvokeVoidAsync("ensureFileInputMultiple");

        if (_shouldScrollToBottom)
        {
            _shouldScrollToBottom = false;
            await _jsModule.InvokeVoidAsync("scrollToBottom", "chat-messages");
        }
    }

    private void Toggle()
    {
        _isOpen = !_isOpen;
        if (_isOpen)
            _shouldScrollToBottom = true;
    }

    private void HandleMessage(ChatMessage message)
    {
        _messages.Add(message);
        _shouldScrollToBottom = true;
        InvokeAsync(StateHasChanged);
    }

    private void HandleUserJoined(string id, string name)
    {
        _activeUsers.Add((id, name));
        InvokeAsync(StateHasChanged);
    }

    private void HandleUserLeft(string id)
    {
        _activeUsers.RemoveAll(u => u.Id == id);
        InvokeAsync(StateHasChanged);
    }

    private void HandleTypingChanged(string userId, string userName, bool isTyping)
    {
        if (userId == _userId) return;

        if (isTyping)
            _typingNames[userId] = userName;
        else
            _typingNames.Remove(userId);

        InvokeAsync(StateHasChanged);
    }

    private async Task OnTextChanged(string value)
    {
        if (!string.IsNullOrEmpty(value) && !_isTyping)
        {
            _isTyping = true;
            await ChatService.SetTypingAsync(_userId, true);
        }

        _typingTimer?.Dispose();
        _typingTimer = new System.Threading.Timer(async _ =>
        {
            _isTyping = false;
            await ChatService.SetTypingAsync(_userId, false);
        }, null, 3000, Timeout.Infinite);
    }

    private string GetTypingText()
    {
        var names = _typingNames.Values.ToList();
        return names.Count switch
        {
            1 => $"{names[0]} {L["Chat_IsTyping"]}",
            2 => $"{names[0]} & {names[1]} {L["Chat_AreTyping"]}",
            _ => $"{names[0]} & {names.Count - 1}+ {L["Chat_AreTyping"]}"
        };
    }

    // ── Send ──
    private async Task Send()
    {
        _typingTimer?.Dispose();
        _isTyping = false;

        var hasText = !string.IsNullOrWhiteSpace(_messageInput);
        var hasImages = _pendingImages.Count > 0;

        if (!hasText && !hasImages) return;

        if (hasImages)
        {
            await ChatService.SendImagesAsync(_userId, _pendingImages, hasText ? _messageInput : null, _clientInfo);
            _pendingImages = new();
        }
        else
        {
            await ChatService.SendMessageAsync(_userId, _messageInput, _clientInfo);
        }

        _messageInput = "";
    }

    // ── Images ──
    private async Task TriggerFileInput()
    {
        _jsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat-interop.js");
        await _jsModule.InvokeVoidAsync("triggerFileInput", "chat-file-input");
    }

    private async Task OnImagesSelected(InputFileChangeEventArgs e)
    {
        const long maxSize = 2 * 1024 * 1024;
        foreach (var file in e.GetMultipleFiles(10))
        {
            using var stream = file.OpenReadStream(maxSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _pendingImages.Add(new ImageData(Convert.ToBase64String(ms.ToArray()), file.ContentType));
        }
    }

    private void RemovePendingImage(int index)
    {
        if (index >= 0 && index < _pendingImages.Count)
            _pendingImages.RemoveAt(index);
    }

    // ── Lightbox ──
    private void OpenLightbox(IReadOnlyList<ImageData> images, int index)
    {
        _lightboxImages = images;
        _lightboxIndex = index;
    }

    private void CloseLightbox()
    {
        _lightboxImages = null;
    }

    // ── Audio ──
    private async Task StartRecording()
    {
        _cancelRecording = false;
        var started = await JS.InvokeAsync<bool>("chatAudio.start", _dotNetRef);
        _isRecording = started;
    }

    private async Task StopAndSendRecording()
    {
        _isRecording = false;
        await JS.InvokeVoidAsync("chatAudio.stop");
    }

    private async Task CancelRecording()
    {
        _cancelRecording = true;
        _isRecording = false;
        await JS.InvokeVoidAsync("chatAudio.stop");
    }

    [JSInvokable]
    public async Task OnAudioChunkReceived(string chunk, int index, int total, bool done)
    {
        if (_cancelRecording)
        {
            if (done)
            {
                _audioChunks.Clear();
                _cancelRecording = false;
                await InvokeAsync(StateHasChanged);
            }
            return;
        }

        if (!done)
        {
            _audioChunks.Append(chunk);
            return;
        }

        var base64Data = _audioChunks.ToString();
        _audioChunks.Clear();

        if (!string.IsNullOrEmpty(base64Data))
        {
            await ChatService.SendMediaAsync(_userId, MessageType.Audio, base64Data, "audio/webm", clientInfo: _clientInfo);
        }
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _typingTimer?.Dispose();

        // Clean up audio players in JS
        if (_jsModule is not null)
        {
            var playerIds = _messages
                .Where(m => m.Type == MessageType.Audio && m.MediaData is not null)
                .Select(m => $"ap-{m.UserId}-{m.Timestamp.Ticks}")
                .ToArray();

            if (playerIds.Length > 0)
            {
                try { await _jsModule.InvokeVoidAsync("destroyAudioPlayers", (object)playerIds); }
                catch (JSDisconnectedException) { }
            }

            try { await _jsModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }

        if (_isRecording)
        {
            try { await JS.InvokeVoidAsync("chatAudio.stop"); }
            catch (JSDisconnectedException) { }
        }

        _dotNetRef?.Dispose();
        ChatService.OnMessageReceived -= HandleMessage;
        ChatService.OnUserJoined -= HandleUserJoined;
        ChatService.OnUserLeft -= HandleUserLeft;
        ChatService.OnTypingChanged -= HandleTypingChanged;
        await ChatService.SetTypingAsync(_userId, false);
        await ChatService.UnregisterUserAsync(_userId);
    }
}
