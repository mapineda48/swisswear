@using SwissWear.Web.Services

<div id="@PlayerId" class="chat-audio-player" style="display: flex; align-items: center; gap: 8px; min-width: 180px; margin: 4px 0;">
    <button class="ap-btn" type="button"
            onclick="chatAudio.togglePlay('@PlayerId')"
            style="width: 32px; height: 32px; border-radius: 50%; border: none; cursor: pointer; font-size: 14px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: @ButtonBackground; color: white;">
        ▶
    </button>
    <div style="flex: 1; display: flex; flex-direction: column; gap: 2px;">
        <div class="ap-bar" onclick="chatAudio.seekPlayer('@PlayerId', event)"
             style="height: 6px; background: @BarBackground; border-radius: 3px; cursor: pointer; overflow: hidden;">
            <div class="ap-progress-fill"
                 style="height: 100%; width: 0%; background: @ProgressColor; border-radius: 3px; transition: width 0.1s linear;"></div>
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 0.6rem; opacity: 0.7;">
            <span class="ap-current">0:00</span>
            <span class="ap-duration">0:00</span>
        </div>
    </div>
</div>
<audio preload="metadata" style="display:none;" id="@(PlayerId)-audio">
    <source src="@AudioSource" type="@ContentType" />
</audio>

@code {
    [Parameter, EditorRequired]
    public string PlayerId { get; set; } = "";

    [Parameter, EditorRequired]
    public string AudioSource { get; set; } = "";

    [Parameter, EditorRequired]
    public string ContentType { get; set; } = "";

    [Parameter]
    public bool IsOwnMessage { get; set; }

    private string ButtonBackground => IsOwnMessage ? "rgba(255,255,255,0.2)" : "var(--mud-palette-primary)";
    private string BarBackground => IsOwnMessage ? "rgba(255,255,255,0.3)" : "var(--mud-palette-lines-default)";
    private string ProgressColor => IsOwnMessage ? "white" : "var(--mud-palette-primary)";
}
