{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SwissWear.Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/SwissWear.Web/bin/Debug/net10.0/SwissWear.Web.dll",
      "args": ["--launch-profile", "http"],
      "cwd": "${workspaceFolder}/src/SwissWear.Web",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ROOT": "/home/mapineda48/.dotnet"
      }
    }
  ]
}
